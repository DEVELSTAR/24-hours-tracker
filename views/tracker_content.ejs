<div class="space-y-8 sm:space-y-10">
  <div class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-md rounded-xl sm:rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700 p-10 sm:p-12 lg:p-16">
    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 sm:gap-6">
      <div class="flex items-center gap-3 sm:gap-4 w-full lg:w-auto flex-1">
        <a href="/tracker?date=<%= prevDate %>" class="nav-btn-secondary p-2.5 sm:p-3" title="Previous Day">
          <svg class="w-5 h-5 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </a>
        <div class="flex flex-col items-center sm:items-start flex-1">
          <input type="date" id="date-picker" value="<%= date %>" class="w-full px-4 py-3 sm:px-4 sm:py-3 rounded-lg border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 font-medium focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm sm:text-base">
          <span class="text-sm text-gray-500 dark:text-gray-400 mt-2">
            <%= isToday ? 'Today' : new Date(date).toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' }) %>
          </span>
        </div>
        <a href="/tracker?date=<%= nextDate %>" class="nav-btn-secondary p-2.5 sm:p-3" title="Next Day">
          <svg class="w-5 h-5 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
        <% if (!isToday) { %>
          <a href="/tracker?date=<%= today %>" class="nav-btn-primary ml-2 px-4 py-2.5 sm:px-5 sm:py-3 text-sm sm:text-base">
            <svg class="w-5 h-5 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span class="hidden sm:inline ml-2">Today</span>
          </a>
        <% } %>
      </div>
      <div class="flex items-center gap-3 flex-wrap w-full lg:w-auto justify-end">
        <button onclick="showAddEntryModal()" class="nav-btn-primary px-4 py-2.5 sm:px-5 sm:py-3 text-sm sm:text-base flex-1 sm:flex-none">
          <svg class="w-5 h-5 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span class="hidden sm:inline ml-2">Add Activity</span>
        </button>
        <button onclick="copyYesterday()" class="nav-btn-secondary px-4 py-2.5 sm:px-5 sm:py-3 text-sm sm:text-base">
          <svg class="w-5 h-5 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"></path>
          </svg>
          <span class="hidden sm:inline ml-2">Copy Yesterday</span>
        </button>
        <% if (templates.length > 0) { %>
          <div class="relative group">
            <button class="nav-btn-secondary px-4 py-2.5 sm:px-5 sm:py-3 text-sm sm:text-base">
              <svg class="w-5 h-5 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
              </svg>
              <span class="hidden sm:inline ml-2">Templates</span>
            </button>
            <div class="absolute right-0 top-full mt-2 w-48 sm:w-56 bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-gray-200 dark:border-slate-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
              <% templates.forEach(function(t) { %>
                <button onclick="applyTemplate(<%= t.id %>)" class="w-full text-left px-4 py-3 hover:bg-gray-50 dark:hover:bg-slate-700 first:rounded-t-xl last:rounded-b-xl text-sm text-gray-700 dark:text-gray-300">
                  <%= t.name.replace(/\$/g, '&#36;') %>
                </button>
              <% }); %>
            </div>
          </div>
        <% } %>
        <button onclick="showSaveTemplateModal()" class="nav-btn-secondary px-4 py-2.5 sm:px-5 sm:py-3 text-sm sm:text-base">
          <svg class="w-5 h-5 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path>
          </svg>
          <span class="hidden sm:inline ml-2">Save</span>
        </button>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6">
    <div class="stat-card p-5 sm:p-7">
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-5 h-5 sm:w-5 sm:h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span class="text-sm font-medium text-gray-600 dark:text-gray-400">Allocated</span>
      </div>
      <span class="text-2xl sm:text-3xl font-bold text-gray-800 dark:text-gray-200"><%= allocatedHours %>h</span>
      <span class="text-sm text-gray-500 dark:text-gray-400 block">of 24 hours</span>
    </div>
    <div class="stat-card p-5 sm:p-7">
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-5 h-5 sm:w-5 sm:h-5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span class="text-sm font-medium text-gray-600 dark:text-gray-400">Unallocated</span>
      </div>
      <span class="text-2xl sm:text-3xl font-bold <%= unallocatedHours > 0 ? 'text-amber-600 dark:text-amber-400' : 'text-gray-800 dark:text-gray-200' %>"><%= unallocatedHours %>h</span>
      <span class="text-sm text-gray-500 dark:text-gray-400 block">remaining</span>
    </div>
    <div class="stat-card col-span-2 p-5 sm:p-7">
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-5 h-5 sm:w-5 sm:h-5 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
        </svg>
        <span class="text-sm font-medium text-gray-600 dark:text-gray-400">Productivity</span>
      </div>
      <div class="flex items-end gap-2">
        <span id="productivity-score" class="text-3xl sm:text-4xl font-bold text-indigo-600 dark:text-indigo-400"><%= productivityPercentage %>%</span>
        <span class="text-sm text-gray-500 dark:text-gray-400 mb-1"><%= totalLogged %>h productive</span>
      </div>
      <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2 mt-3">
        <div id="productivity-bar" class="bg-gradient-to-r from-indigo-500 to-purple-500 h-2 rounded-full transition-all duration-500" style="width: <%= productivityPercentage %>%"></div>
      </div>
    </div>
  </div>

  <% if (stats.length > 0) { %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 sm:gap-4">
      <% stats.forEach(function(stat) { %>
        <div class="stat-card hover:shadow-lg transition-shadow duration-300 p-4 sm:p-5">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-3 h-3 rounded-full" style="background-color: <%= stat.color %>"></div>
            <span class="text-sm font-medium text-gray-600 dark:text-gray-400 truncate"><%= stat.name.replace(/\$/g, '&#36;') %></span>
          </div>
          <span class="text-xl sm:text-2xl font-bold text-gray-800 dark:text-gray-200"><%= stat.hours || 0 %>h</span>
        </div>
      <% }); %>
    </div>
  <% } %>

  <div class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-md rounded-xl sm:rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700 overflow-hidden">
    <div class="p-6 sm:p-8 lg:p-10 border-b border-gray-100 dark:border-slate-700 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4">
      <div>
        <h2 class="text-lg sm:text-xl font-semibold text-gray-800 dark:text-gray-200">Time Entries</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 hidden sm:block">Manage your daily activities with start and end times</p>
      </div>
      <div class="text-sm text-gray-500 dark:text-gray-400 self-end sm:self-auto">
        <%= entries.length %> <%= entries.length === 1 ? 'entry' : 'entries' %>
      </div>
    </div>
    <% if (entries.length === 0) { %>
      <div class="p-16 sm:p-20 text-center">
        <div class="w-16 h-16 sm:w-20 sm:h-20 bg-gray-100 dark:bg-slate-700 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 sm:w-10 sm:h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
        </div>
        <h3 class="text-lg sm:text-xl font-medium text-gray-800 dark:text-gray-200 mb-2">No activities yet</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">Add your first activity to track your day</p>
        <button onclick="showAddEntryModal()" class="nav-btn-primary px-6 py-3 sm:px-8 sm:py-3 text-sm sm:text-base">Add Activity</button>
      </div>
    <% } else { %>
      <div class="divide-y divide-gray-100 dark:divide-slate-700" id="entries-container">
        <% entries.forEach(function(entry) { %>
          <div class="entry-row group flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6 p-6 sm:p-8 hover:bg-gray-50/50 dark:hover:bg-slate-700/30 transition-colors" data-entry-id="<%= entry.id %>">
            <div class="flex items-center gap-2 w-full sm:w-40 flex-shrink-0 text-sm font-medium text-gray-600 dark:text-gray-400">
              <span><%= formatTime(entry.start_time) %></span>
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
              <span><%= formatTime(entry.end_time) %></span>
            </div>
            <div class="flex w-full sm:w-20 flex-shrink-0">
              <span class="px-3 py-1.5 rounded-full bg-gray-100 dark:bg-slate-700 text-sm text-gray-600 dark:text-gray-400">
                <%= formatDuration(entry.end_time - entry.start_time) %>
              </span>
            </div>
            <div class="flex-1 min-w-0 w-full">
              <div class="flex items-center gap-3 sm:gap-4">
                <% if (entry.activity_name) { %>
                  <div class="flex items-center gap-2">
                    <span class="text-lg sm:text-xl"><%= (entry.emoji || '').replace(/\$/g, '&#36;') %></span>
                    <span class="font-medium text-base sm:text-lg text-gray-800 dark:text-gray-200 truncate"><%= entry.activity_name.replace(/\$/g, '&#36;') %></span>
                  </div>
                  <div class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: <%= entry.color %>"></div>
                <% } else { %>
                  <span class="text-base text-gray-500 dark:text-gray-400 italic">No activity</span>
                <% } %>
              </div>
              <% if (entry.note) { %>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 truncate"><%= (entry.note || '').replace(/\$/g, '&#36;') %></p>
              <% } %>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto justify-end opacity-100 sm:opacity-0 group-hover:opacity-100 transition-opacity">
              <button onclick="editEntry(<%= entry.id %>, <%= entry.activity_id || 'null' %>, <%= entry.start_time %>, <%= entry.end_time %>, '<%= (entry.note || '').replace(/'/g, "\\'").replace(/\$/g, '&#36;') %>')" class="p-2.5 rounded-lg text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 transition-colors" title="Edit">
                <svg class="w-5 h-5 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
              </button>
              <button onclick="deleteEntry(<%= entry.id %>)" class="p-2.5 rounded-lg text-gray-400 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors" title="Delete">
                <svg class="w-5 h-5 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<script>
  function formatTime(minutes) {
    const h = Math.floor(minutes / 60);
    const m = minutes % 60;
    const ampm = h >= 12 ? 'PM' : 'AM';
    const displayH = h % 12 || 12;
    const displayM = m.toString().padStart(2, '0');
    return displayM === '00' ? (displayH + ' ' + ampm) : (displayH + ':' + displayM + ' ' + ampm);
  }
  function formatDuration(minutes) {
    const h = Math.floor(minutes / 60);
    const m = minutes % 60;
    if (h === 0) return m + 'm';
    if (m === 0) return h + 'h';
    return h + 'h ' + m + 'm';
  }
  window.TRACKER_DATA = {
    date: '<%= date %>',
    activities: <%- JSON.stringify(activities) %>,
    templates: <%- JSON.stringify(templates) %>,
    allocatedHours: <%= allocatedHours %>,
    unallocatedHours: <%= unallocatedHours %>
  };
</script>
<script src="/js/tracker.js"></script>
