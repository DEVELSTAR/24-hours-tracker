<div class="space-y-8 sm:space-y-10">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 sm:gap-6">
    <div class="flex-1">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">Manage Activities</h1>
      <p class="text-base sm:text-lg text-gray-600 dark:text-gray-400 mt-2">Customize your activity types with emojis and colors</p>
    </div>
    <button onclick="showAddActivityModal()" class="nav-btn-primary px-5 py-3 sm:px-6 sm:py-3 text-sm sm:text-base w-full sm:w-auto flex items-center justify-center gap-2">
      <svg class="w-5 h-5 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      <span>Add New Activity</span>
    </button>
  </div>

  <% if (error) { %>
    <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-300 px-4 py-3 rounded-lg text-sm">
      <%= error %>
    </div>
  <% } %>

  <% if (success) { %>
    <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-700 dark:text-green-300 px-4 py-3 rounded-lg text-sm">
      <%= success %>
    </div>
  <% } %>

  <!-- Activities Grid -->
  <div class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-md rounded-xl sm:rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700 overflow-hidden">
    <div class="p-10 sm:p-12 lg:p-16 border-b border-gray-100 dark:border-slate-700">
      <h2 class="text-lg sm:text-xl font-semibold text-gray-800 dark:text-gray-200">Your Activities</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
        <%= activities.length %> activities • Default activities cannot be deleted
      </p>
    </div>
    
    <div class="divide-y divide-gray-100 dark:divide-slate-700">
      <% activities.forEach(function(activity, index) { %>
        <div class="p-10 sm:p-12 lg:p-16 flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6 hover:bg-gray-50/50 dark:hover:bg-slate-700/30 transition-colors">
          <!-- Activity Preview & Info -->
          <div class="flex items-center gap-4 sm:gap-6 w-full sm:w-auto">
            <!-- Activity Preview -->
            <div 
              class="w-14 h-14 sm:w-16 sm:h-16 rounded-xl flex items-center justify-center text-2xl sm:text-2xl shadow-sm flex-shrink-0"
              style="background-color: <%= activity.color %>20; border: 2px solid <%= activity.color %>"
            >
              <%= activity.emoji %>
            </div>
            
            <!-- Activity Info -->
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-semibold text-base sm:text-lg text-gray-900 dark:text-white"><%= activity.name %></h3>
                <% if (activity.is_default) { %>
                  <span class="px-2.5 py-1 text-xs font-medium bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-gray-400 rounded-full">
                    Default
                  </span>
                <% } %>
                <% if (activity.is_productive) { %>
                  <span class="px-2.5 py-1 text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 rounded-full">
                    Productive
                  </span>
                <% } %>
              </div>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                <%= activity.usage_count %> hours tracked
              </p>
            </div>
          </div>
          
          <!-- Color Preview (hidden on mobile) -->
          <div class="hidden sm:flex items-center gap-2">
            <span class="text-sm text-gray-500 dark:text-gray-400">Color:</span>
            <div class="w-8 h-8 rounded-lg shadow-sm" style="background-color: <%= activity.color %>"></div>
          </div>
          
          <!-- Actions -->
          <div class="flex items-center gap-2 w-full sm:w-auto justify-end pt-2 sm:pt-0">
            <button 
              onclick="editActivity(<%= activity.id %>, '<%= activity.name.replace(/'/g, "\\'") %>', '<%= activity.emoji %>', '<%= activity.color %>', <%= activity.is_productive %>)"
              class="p-2.5 text-gray-600 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 rounded-lg transition-colors"
              title="Edit Activity"
            >
              <svg class="w-5 h-5 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
            </button>
            
            <% if (!activity.is_default) { %>
              <button 
                onclick="deleteActivity(<%= activity.id %>, '<%= activity.name.replace(/'/g, "\\'") %>', <%= activity.usage_count %>)"
                class="p-2.5 text-gray-600 dark:text-gray-400 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors"
                title="Delete Activity"
              >
                <svg class="w-5 h-5 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            <% } else { %>
              <button 
                disabled
                class="p-2.5 text-gray-300 dark:text-gray-600 cursor-not-allowed"
                title="Default activities cannot be deleted"
              >
                <svg class="w-5 h-5 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</div>

<script src="/js/activities.js"></script>
